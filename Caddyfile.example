# Example Caddy configuration for Cadence (cadence.brndn.me).
#
# The production config is cadence.caddy (symlinked into /etc/caddy/sites/).
# This file shows the full standalone config for reference.
#
# If using the per-site import pattern, the main Caddyfile needs:
#   import /etc/caddy/sites/*.caddy
#
# And the main Caddyfile must define these reusable snippets:
#   (api_proxy)  — compression + security headers for API backends
#   (spa_site)   — SPA fallback + file_server + security headers + asset caching
#
# Setup:
#   ln -s /path/to/cadence/cadence.caddy /etc/caddy/sites/cadence.caddy
#   caddy validate --config /etc/caddy/Caddyfile && sudo caddy reload

cadence.brndn.me {
    # --- API with prefix stripping ---
    handle_path /api* {
        reverse_proxy 127.0.0.1:3033
        encode zstd gzip
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
        }
    }

    # --- UI (React SPA) ---
    handle {
        root * /usr/share/nginx/cadence/ui/dist
        @notFile not file
        rewrite @notFile /index.html
        encode zstd gzip
        file_server
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
            X-XSS-Protection "1; mode=block"
            Permissions-Policy "camera=(), microphone=(), geolocation=()"
            Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; script-src 'self' https:; connect-src 'self' https: wss:; frame-ancestors 'none'; upgrade-insecure-requests;"
        }
        @assets path *.js *.css *.mjs *.cjs *.map *.svg *.png *.jpg *.jpeg *.gif *.webp *.ico *.woff *.woff2
        header @assets Cache-Control "public, max-age=31536000, immutable"
    }
}
